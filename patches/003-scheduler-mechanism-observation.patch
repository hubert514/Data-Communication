 void
+RrMultiUserScheduler::TraceMechanismObservation(const MasterInfo& info,
+                                                const std::string& phase,
+                                                uint32_t order,
+                                                int16_t tid,
+                                                AcIndex ac,
+                                                bool selected)
+{
+    uint32_t queuePackets = 0;
+    uint32_t queueBytes = 0;
+    if (tid >= 0)
+    {
+        const auto queueId = MakeWifiUnicastQueueId(WIFI_QOSDATA_QUEUE,
+                                                    info.address,
+                                                    static_cast<uint8_t>(tid));
+        const auto queue = m_apMac->GetQosTxop(ac)->GetWifiMacQueue();
+        queuePackets = queue->GetNPackets(queueId);
+        queueBytes = queue->GetNBytes(queueId);
+    }
+    m_mechanismObservation(m_currentObservationDecision,
+                           m_linkId,
+                           phase,
+                           order,
+                           info.aid,
+                           info.address,
+                           tid,
+                           ac,
+                           info.credits,
+                           queuePackets,
+                           queueBytes,
+                           selected);
+}

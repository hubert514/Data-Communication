+void
+RrMultiUserScheduler::ApplyQueueAgePriority(AcIndex primaryAc, const std::vector<uint8_t>& tids)
+{
+    std::map<uint16_t, Time> oldestTimestamp;
+
+    for (const auto& station : m_staListDl[primaryAc])
+    {
+        for (uint8_t tid : tids)
+        {
+            if (!m_apMac->GetBaAgreementEstablishedAsOriginator(station.address, tid))
+            {
+                continue;
+            }
+            const auto ac = QosUtilsMapTidToAc(tid);
+            auto mpdu = m_apMac->GetQosTxop(ac)->PeekNextMpdu(m_linkId, tid, station.address);
+            if (mpdu)
+            {
+                TraceCandidateObservation(station, tid, ac, mpdu, "age_rank_observed");
+                if (!oldestTimestamp.contains(station.aid) ||
+                    mpdu->GetTimestamp() < oldestTimestamp.at(station.aid))
+                {
+                    oldestTimestamp[station.aid] = mpdu->GetTimestamp();
+                }
+            }
+        }
+    }
+
+    m_staListDl[primaryAc].sort([&oldestTimestamp](const MasterInfo& lhs, const MasterInfo& rhs) {
+        const bool lhsHasMpdu = oldestTimestamp.contains(lhs.aid);
+        const bool rhsHasMpdu = oldestTimestamp.contains(rhs.aid);
+        if (lhsHasMpdu != rhsHasMpdu)
+        {
+            return lhsHasMpdu;
+        }
+        if (!lhsHasMpdu || oldestTimestamp.at(lhs.aid) == oldestTimestamp.at(rhs.aid))
+        {
+            return false; // stable list::sort preserves the existing RR order for ties
+        }
+        return oldestTimestamp.at(lhs.aid) < oldestTimestamp.at(rhs.aid);
+    });
+}
+
+void
+RrMultiUserScheduler::TraceCandidateObservation(const MasterInfo& info,
+                                                int16_t tid,
+                                                AcIndex ac,
+                                                Ptr<const WifiMpdu> mpdu,
+                                                const std::string& status)
+{
+    const bool hasMpdu = (mpdu != nullptr);
+    const uint64_t mpduUid = hasMpdu ? mpdu->GetPacket()->GetUid() : 0;
+    const int64_t timestampNs = hasMpdu ? mpdu->GetTimestamp().GetNanoSeconds() : 0;
+    const int64_t ageNs = hasMpdu ? (Simulator::Now() - mpdu->GetTimestamp()).GetNanoSeconds() : 0;
+
+    m_candidateObservation(m_currentObservationDecision,
+                           m_linkId,
+                           m_observationScanOrder++,
+                           info.aid,
+                           info.address,
+                           tid,
+                           ac,
+                           hasMpdu,
+                           mpduUid,
+                           timestampNs,
+                           ageNs,
+                           status);
+}

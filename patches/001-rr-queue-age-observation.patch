+{
+    g_rrTrace << g_rrTraceRunId << ',' << decisionId << ",candidate,"
+              << Simulator::Now().GetNanoSeconds() << ',' << +linkId << ',' << AcName(ac) << ','
+              << scanOrder << ',' << aid << ',' << address << ',';
+    if (tid >= 0)
+    {
+        g_rrTrace << tid;
+    }
+    g_rrTrace << ',';
+    if (hasMpdu)
